{
  "name": "javascript-devsecops-starter",
  "version": "1.0.0",
  "private": true,
  "description": "Reusable JavaScript/Node.js DevSecOps security starter",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "npm run lint && npm test",
    "security:secrets": "gitleaks detect --source . --no-banner",
    "security:deps": "npm audit --audit-level=high",
    "security:sast": "semgrep scan --config p/javascript --error .",
    "security:local": "bash scripts/security-check.sh"
  },
  "dependencies": {
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@vitest/coverage-v8": "^3.0.8",
    "eslint": "^9.22.0",
    "eslint-plugin-security": "^3.0.1",
    "globals": "^16.0.0",
    "prettier": "^3.5.3",
    "supertest": "^7.1.0",
    "vitest": "^3.0.8"
  }
}
